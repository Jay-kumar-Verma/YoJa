# Security configuration for ML API
# This file contains security settings loaded at runtime

# File upload restrictions
MAX_FILE_SIZE=5242880  # 5MB in bytes
MAX_FRAME_SIZE=2097152  # 2MB in bytes
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,bmp,webp
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/bmp,image/webp

# Rate limiting configuration
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600  # 1 hour in seconds
RATE_LIMIT_BURST=20     # Burst allowance

# CORS security settings
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yoja.app
ALLOWED_METHODS=GET,POST,OPTIONS,HEAD
ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,Accept,Origin
MAX_AGE=86400  # 24 hours

# Security headers
ENABLE_HSTS=true
HSTS_MAX_AGE=31536000  # 1 year
ENABLE_CSP=true
CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' ws: wss:

# Authentication and encryption
JWT_SECRET_KEY_LENGTH=32
SESSION_TIMEOUT=1800  # 30 minutes
BCRYPT_ROUNDS=12

# Logging and monitoring
LOG_LEVEL=INFO
LOG_MAX_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=5
ENABLE_ACCESS_LOG=true
ENABLE_ERROR_LOG=true

# Performance and resource limits
MAX_WORKERS=4
WORKER_TIMEOUT=30
KEEPALIVE_TIMEOUT=2
MAX_REQUESTS_PER_WORKER=1000
GRACEFUL_TIMEOUT=30

# WebSocket security
WS_MAX_CONNECTIONS=50
WS_MESSAGE_QUEUE_SIZE=100
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=10

# Database security (if applicable)
DB_CONNECTION_TIMEOUT=30
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# Content validation
MAX_JSON_SIZE=1048576  # 1MB
MAX_FORM_SIZE=16777216  # 16MB
VALIDATE_CONTENT_TYPE=true
STRIP_EXIF_DATA=true

# Trust and security
TRUSTED_PROXIES=127.0.0.1,::1
PROXY_HEADERS_TIMEOUT=5
ENABLE_PROXY_PROTOCOL=false

# Development/Debug settings (set to false in production)
DEBUG_MODE=false
ENABLE_SWAGGER_UI=false
ENABLE_REDOC=false
EXPOSE_SERVER_INFO=false
